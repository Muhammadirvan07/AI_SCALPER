AI_SCALPER_DASHBOARD_LOG_MAX_BYTES=5242880
AI_SCALPER_DASHBOARD_LOG_BACKUP_COUNT=3

# Kalender ekonomi mingguan read-only. Isi kosong eksplisit untuk menonaktifkan.
