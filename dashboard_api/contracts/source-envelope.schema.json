{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-scalper.local/contracts/source-envelope.schema.json",
  "title": "AI_SCALPER Dashboard Source Envelope",
  "type": "object",
  "required": ["schema_version", "updated_at", "source", "data"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "source": {"type": "string", "minLength": 1},
    "event_id": {"type": ["string", "null"]},
    "data_status": {
      "enum": ["fresh", "stale", "partial", "unavailable", "invalid"]
    },
    "data": {}
  },
  "additionalProperties": true
}
