APP_NAME=AI_SCALPER_BACKEND
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=true

AI_SCALPER_ROOT=/Users/muhammadirvan/Documents/AI_SCALPER
DATA_DIRECTORY=/Users/muhammadirvan/Documents/AI_SCALPER/data

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
TRUSTED_HOSTS=localhost,127.0.0.1

FILE_WATCH_INTERVAL_SECONDS=1
FILE_WATCH_DEBOUNCE_SECONDS=0.25
MARKET_DATA_CACHE_SECONDS=2
DASHBOARD_CACHE_SECONDS=3
LOG_LEVEL=INFO

LIVE_TRADING_ALLOWED=false
MAX_ALLOWED_LOT=0.01

# News Intelligence is metadata-only and never writes to the trading engine.
NEWS_ENABLED=true
NEWS_EXTERNAL_REQUESTS_ENABLED=true
NEWS_PRIMARY_PROVIDER=investing_rss
NEWS_FALLBACK_PROVIDERS=official_rss,gdelt,file,alpha_vantage,finnhub
NEWS_PROVIDER_FAILURE_THRESHOLD=3
NEWS_PROVIDER_COOLDOWN_SECONDS=300
NEWS_GLOBAL_REFRESH_INTERVAL_SECONDS=300
NEWS_MAX_PARALLEL_PROVIDER_REQUESTS=3
NEWS_PROVIDER_MODE=registry
NEWS_REFRESH_INTERVAL_SECONDS=300
NEWS_CACHE_TTL_SECONDS=180
NEWS_REQUEST_TIMEOUT_SECONDS=10
NEWS_MAX_ARTICLES_PER_PROVIDER=100
NEWS_REALTIME_MAX_AGE_HOURS=72
NEWS_RECENT_MAX_AGE_HOURS=168
NEWS_HISTORICAL_RETENTION_DAYS=30
NEWS_DEFAULT_FRESHNESS=live
NEWS_RECENT_FALLBACK_ENABLED=true
# Deprecated compatibility only. Leave empty for new installations.
NEWS_MAX_ARTICLE_AGE_HOURS=
NEWS_DEFAULT_LANGUAGE=en
NEWS_ALLOWED_LANGUAGES=en,id,ja
NEWS_SENTIMENT_ENABLED=true
NEWS_FINBERT_ENABLED=false
NEWS_FINBERT_MODEL=ProsusAI/finbert
NEWS_FINBERT_DEVICE=auto
NEWS_FINBERT_BATCH_SIZE=8
NEWS_ARCHIVE_PATH=
# Legacy generic RSS settings. Official RSS uses OFFICIAL_RSS_FEEDS_CONFIG.
NEWS_RSS_FEEDS=
NEWS_ALLOWED_HOSTS=
NEWS_MAX_RESPONSE_BYTES=2097152
NEWS_ENGINE_INTEGRATION_ENABLED=false

INVESTING_RSS_ENABLED=true
INVESTING_RSS_FEEDS_CONFIG=backend/config/investing_rss_feeds.json
INVESTING_RSS_REFRESH_INTERVAL_SECONDS=300
INVESTING_RSS_REQUEST_TIMEOUT_SECONDS=12
INVESTING_RSS_MAX_ITEMS_PER_FEED=100
INVESTING_RSS_MAX_TOTAL_ITEMS=500
INVESTING_RSS_MAX_RESPONSE_BYTES=2097152
INVESTING_RSS_USER_AGENT=AI_SCALPER-NewsIntelligence/1.0
INVESTING_RSS_USE_CONDITIONAL_REQUESTS=true
INVESTING_RSS_FAILURE_THRESHOLD=3
INVESTING_RSS_COOLDOWN_SECONDS=300

# Paid/keyed providers remain disabled until credentials are configured.
ALPHA_VANTAGE_ENABLED=false
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co
ALPHA_VANTAGE_REQUEST_TIMEOUT_SECONDS=12
ALPHA_VANTAGE_REFRESH_INTERVAL_SECONDS=300
ALPHA_VANTAGE_MAX_ARTICLES=100
ALPHA_VANTAGE_USE_PROVIDER_SENTIMENT=true
ALPHA_VANTAGE_MAX_REQUESTS_PER_MINUTE=

FINNHUB_ENABLED=false
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINNHUB_REQUEST_TIMEOUT_SECONDS=12
FINNHUB_REFRESH_INTERVAL_SECONDS=300
FINNHUB_MAX_ARTICLES=100
FINNHUB_ECONOMIC_CALENDAR_ENABLED=false
FINNHUB_MAX_REQUESTS_PER_MINUTE=

TRADING_ECONOMICS_ENABLED=false
TRADING_ECONOMICS_API_KEY=
TRADING_ECONOMICS_API_SECRET=
TRADING_ECONOMICS_BASE_URL=https://api.tradingeconomics.com
TRADING_ECONOMICS_REQUEST_TIMEOUT_SECONDS=15
TRADING_ECONOMICS_REFRESH_INTERVAL_SECONDS=900
TRADING_ECONOMICS_STREAMING_ENABLED=false
TRADING_ECONOMICS_HIGH_IMPACT_ONLY=false
TRADING_ECONOMICS_MAX_REQUESTS_PER_MINUTE=

# Keyless trusted providers.
GDELT_ENABLED=true
GDELT_BASE_URL=https://api.gdeltproject.org
GDELT_REQUEST_TIMEOUT_SECONDS=15
GDELT_REFRESH_INTERVAL_SECONDS=900
GDELT_MAX_ARTICLES=100
GDELT_DEFAULT_TIMESPAN_HOURS=24
GDELT_SOURCE_LANGUAGES=en,id,ja
GDELT_TRANSLATED_RESULTS_ENABLED=true
GDELT_MAX_REQUESTS_PER_MINUTE=
GDELT_MIN_REQUEST_INTERVAL_SECONDS=60
GDELT_MAX_REQUESTS_PER_REFRESH=2
GDELT_MAX_PARALLEL_REQUESTS=1
GDELT_BACKOFF_INITIAL_SECONDS=300
GDELT_BACKOFF_MAX_SECONDS=3600
GDELT_BACKOFF_MULTIPLIER=2
GDELT_JITTER_SECONDS=30
GDELT_USE_LAST_KNOWN_GOOD=true

OFFICIAL_RSS_ENABLED=true
OFFICIAL_RSS_FEEDS_CONFIG=backend/config/news_feeds.json
OFFICIAL_RSS_REFRESH_INTERVAL_SECONDS=600
OFFICIAL_RSS_REQUEST_TIMEOUT_SECONDS=10
OFFICIAL_RSS_MAX_ITEMS_PER_FEED=50

FILE_NEWS_PROVIDER_ENABLED=true
FILE_NEWS_PATH=/Users/muhammadirvan/Documents/AI_SCALPER/data/news_articles.json
FILE_ECONOMIC_CALENDAR_PATH=/Users/muhammadirvan/Documents/AI_SCALPER/data/economic_calendar.json
FILE_NEWS_WATCH_ENABLED=true

ECONOMIC_CALENDAR_ENABLED=true
# Native calendar reads allowlisted official sources; it never uses an iframe.
ECONOMIC_CALENDAR_EXTERNAL_REQUESTS_ENABLED=true
ECONOMIC_CALENDAR_PATH=
# Deprecated compatibility alias. Prefer ECONOMIC_CALENDAR_SYNC_INTERVAL_SECONDS.
ECONOMIC_CALENDAR_REFRESH_INTERVAL_SECONDS=900
ECONOMIC_CALENDAR_SYNC_INTERVAL_SECONDS=900
ECONOMIC_CALENDAR_WATCH_INTERVAL_SECONDS=120
ECONOMIC_CALENDAR_PRE_RELEASE_INTERVAL_SECONDS=30
ECONOMIC_CALENDAR_RELEASE_INTERVAL_SECONDS=10
ECONOMIC_CALENDAR_POST_RELEASE_INTERVAL_SECONDS=60
ECONOMIC_CALENDAR_WATCH_WINDOW_MINUTES=60
ECONOMIC_CALENDAR_PRE_RELEASE_WINDOW_MINUTES=10
ECONOMIC_CALENDAR_RELEASE_WINDOW_MINUTES=1
ECONOMIC_CALENDAR_POST_RELEASE_WINDOW_MINUTES=10
ECONOMIC_CALENDAR_REQUEST_TIMEOUT_SECONDS=15
ECONOMIC_CALENDAR_MAX_PARALLEL_REQUESTS=3
ECONOMIC_CALENDAR_CACHE_TTL_SECONDS=60
ECONOMIC_CALENDAR_RETENTION_DAYS=365
ECONOMIC_CALENDAR_DEFAULT_TIMEZONE=UTC
ECONOMIC_CALENDAR_MAX_RESPONSE_BYTES=2097152
ECONOMIC_CALENDAR_USER_AGENT=AI_SCALPER-EconomicCalendar/1.0 (read-only official release monitor)
ECONOMIC_CALENDAR_PROVIDER_FAILURE_THRESHOLD=3
ECONOMIC_CALENDAR_PROVIDER_COOLDOWN_SECONDS=300
ECONOMIC_CALENDAR_FILE_PROVIDER_ENABLED=true
ECONOMIC_CALENDAR_FILE_PATH=/Users/muhammadirvan/Documents/AI_SCALPER/data/economic_calendar.json
# Optional backend-owned last-known-good cache. Leave empty to keep cache memory-only.
ECONOMIC_CALENDAR_CACHE_PATH=
ECONOMIC_CALENDAR_BLS_ENABLED=true
ECONOMIC_CALENDAR_BEA_ENABLED=true
ECONOMIC_CALENDAR_FEDERAL_RESERVE_ENABLED=true
ECONOMIC_CALENDAR_ECB_ENABLED=true
ECONOMIC_CALENDAR_ENGINE_INTEGRATION_ENABLED=false
ECONOMIC_CALENDAR_DIAGNOSTICS_ENABLED=true
ECONOMIC_CALENDAR_EXECUTION_GUARD_ENABLED=false
ECONOMIC_CALENDAR_GUARD_PREVIEW_ENABLED=true
